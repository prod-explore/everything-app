{
  "name": "playwright-mcp",
  "version": "0.1.0",
  "description": "MCP server providing controlled web browsing for EverythingApp (domain allowlist, deterministic page filtering)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "playwright": "^1.48.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.18.2",
    "typescript": "^5.4.5"
  }
}
