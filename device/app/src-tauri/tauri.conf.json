{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EverythingApp Device",
  "version": "0.1.1",
  "identifier": "app.everythingapp.device",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EverythingApp",
    "category": "DeveloperTool",
    "shortDescription": "Lets your EverythingApp server use this computer: terminal, files, browser.",
    "icon": [
      "../icons/app/32x32.png",
      "../icons/app/128x128.png",
      "../icons/app/128x128@2x.png",
      "../icons/app/icon.icns",
      "../icons/app/icon.ico"
    ],
    "externalBin": ["binaries/evvapp-node"],
    "resources": {
      "resources/agent": "agent"
    }
  }
}
